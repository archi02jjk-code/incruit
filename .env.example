# 이 파일을 복사해 이름을 .env 로 바꾸고 값을 채우세요.
# .env 는 GitHub에 올리면 안 됩니다 (.gitignore 에 들어 있어요).

# ── 공공데이터포털 (data.go.kr) ─────────────────────────────
# 한 개의 키로 두 API를 모두 씁니다. 단, 두 API 각각 '활용신청'을 해야 해요.
#   1) 인사혁신처_공공취업정보 조회 서비스  https://www.data.go.kr/data/15156780/openapi.do
#   2) 기획재정부_공공기관 채용정보 조회서비스(잡알리오)  https://www.data.go.kr/data/15125273/openapi.do
# 마이페이지 > 활용신청 현황 > 일반 인증키(Decoding) 값을 넣으세요.
DATA_GO_KR_KEY=

# (선택) 잡알리오 키를 따로 받았다면 여기에. 비워 두면 DATA_GO_KR_KEY 를 씁니다.
ALIO_API_KEY=

# ── 경기데이터드림 (data.gg.go.kr) ──────────────────────────
# 회원가입 > 마이페이지 > 인증키 발급
GG_API_KEY=

# 서비스명은 코드에 이미 들어 있어요. 바뀌었을 때만 적으세요.
#   3) 경기도 내 공공일자리 정보(잡아바)        기본값 JobFndtnPublJob
GG_PUBLIC_JOB_SERVICE=
#   4) 경기도일자리재단 잡아바 채용정보(민간)    기본값 GGJOBABARECRUSTM
#      ※ 예전 '민간 채용정보 현황(EmplmntInfoStus)'은 2025년부터 갱신이 중단됐어요.
GG_PRIVATE_JOB_SERVICE=

# (선택) 필드명이 자동으로 안 맞을 때만 직접 지정. 'Open API' 탭의 출력값 영문명을 넣으세요.
# 쓸 수 있는 이름: title, org, start, end, url, area, salary, career, hire
# 예) GG_PUBLIC_JOB_FIELDS={"title":"PBLANC_NM","org":"INST_NM","start":"RCPT_BEGIN_DE","end":"RCPT_END_DE","url":"DETAIL_URL"}
GG_PUBLIC_JOB_FIELDS=
GG_PRIVATE_JOB_FIELDS=
